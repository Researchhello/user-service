<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="5" author="ecommerce">
        <comment>Insert static roles</comment>

        <!-- ROLE_USER -->
        <insert tableName="roles">
            <column name="id" value="12c9c579-a3aa-4d6b-a805-11284946bdac"/>
            <column name="name" value="ROLE_USER"/>
            <column name="description" value="Regular user with basic permissions"/>
        </insert>

        <!-- ROLE_ADMIN -->
        <insert tableName="roles">
            <column name="id" value="40216d9a-e9bd-44af-b7b3-0121a80c150e"/>
            <column name="name" value="ROLE_ADMIN"/>
            <column name="description" value="System administrator with full access"/>
        </insert>

        <!-- ROLE_SELLER -->
        <insert tableName="roles">
            <column name="id" value="bc17d801-ad16-46d7-a833-53ab208ca568"/>
            <column name="name" value="ROLE_SELLER"/>
            <column name="description" value="Seller who can manage products"/>
        </insert>

        <!-- ROLE_MODERATOR -->
        <insert tableName="roles">
            <column name="id" value="333ae3c6-7c8a-481a-a853-4b1e71ab7569"/>
            <column name="name" value="ROLE_MODERATOR"/>
            <column name="description" value="Content moderator"/>
        </insert>

        <rollback>
            <delete tableName="roles">
                <where>name IN ('ROLE_USER', 'ROLE_ADMIN', 'ROLE_SELLER', 'ROLE_MODERATOR')</where>
            </delete>
        </rollback>
    </changeSet>
</databaseChangeLog>