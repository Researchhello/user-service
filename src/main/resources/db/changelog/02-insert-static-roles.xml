<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="5" author="ecommerce">
        <comment>Insert static roles</comment>

        <!-- ROLE_USER -->
        <insert tableName="roles">
            <column name="id" value="11111111-1111-1111-1111-111111111111"/>
            <column name="name" value="ROLE_USER"/>
            <column name="description" value="Regular user with basic permissions"/>
        </insert>

        <!-- ROLE_ADMIN -->
        <insert tableName="roles">
            <column name="id" value="22222222-2222-2222-2222-222222222222"/>
            <column name="name" value="ROLE_ADMIN"/>
            <column name="description" value="System administrator with full access"/>
        </insert>

        <!-- ROLE_SELLER -->
        <insert tableName="roles">
            <column name="id" value="33333333-3333-3333-3333-333333333333"/>
            <column name="name" value="ROLE_SELLER"/>
            <column name="description" value="Seller who can manage products"/>
        </insert>

        <!-- ROLE_MODERATOR -->
        <insert tableName="roles">
            <column name="id" value="44444444-4444-4444-4444-444444444444"/>
            <column name="name" value="ROLE_MODERATOR"/>
            <column name="description" value="Content moderator"/>
        </insert>

        <rollback>
            <delete tableName="roles">
                <where>name IN ('ROLE_USER', 'ROLE_ADMIN', 'ROLE_SELLER', 'ROLE_MODERATOR')</where>
            </delete>
        </rollback>
    </changeSet>
</databaseChangeLog>