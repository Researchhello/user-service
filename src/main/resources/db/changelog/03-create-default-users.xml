        <comment>Create default admin user (development only)</comment>

        <!-- Insert admin user -->
        <insert tableName="users">
            <column name="id" value="aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"/>
            <column name="email" value="admin@ecommerce.com"/>
            <!-- Password: Admin@123 (BCrypted) -->
